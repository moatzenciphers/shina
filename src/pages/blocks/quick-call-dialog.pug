div.quick-call-backdrop(data-quick-call-dialog, hidden)
  div.quick-call-dialog#quick-call-dialog(role="dialog", aria-modal="true", aria-labelledby="quick-call-title", aria-describedby="quick-call-description")
    button.quick-call-dialog__close(type="button", data-quick-call-close, aria-label="Закрыть форму") ×
    p.quick-call-dialog__eyebrow.landing-eyebrow ПОМОЩЬ РЯДОМ
    h2.quick-call-dialog__title.landing-title.landing-title--dialog#quick-call-title Быстрый вызов
    p.quick-call-dialog__description.landing-text.landing-text--dialog#quick-call-description Оставьте номер телефона, чтобы оператор мог вам перезвонить.
    form.quick-call-dialog__form(data-quick-call-form)
      label.quick-call-dialog__label(for="quick-call-phone") Номер телефона
      input.quick-call-dialog__input#quick-call-phone(type="tel", name="phone", inputmode="tel", autocomplete="tel", placeholder="+7 (___) ___-__-__", required, data-quick-call-phone)
      label.quick-call-dialog__consent.landing-consent
        input(type="checkbox", name="privacy_consent", required, data-quick-call-consent)
        span Согласен(на) с политикой конфиденциальности
      button.quick-call-dialog__submit.landing-cta(type="submit") Отправить заявку
      p.quick-call-dialog__status(role="status", aria-live="polite", data-quick-call-status, hidden)
