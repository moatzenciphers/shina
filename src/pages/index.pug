            div.faq-list(data-faq-list)
              +faqItem('initial-1', 'Сколько стоит выезд?', ['Выезд рассчитывается по адресу: внутри МКАД действует базовый тариф, за МКАД добавляется километраж.', 'Итоговая стоимость обновляется в калькуляторе после ввода адреса.'], true)
              +faqItem('initial-2', 'Как быстро приедет мастер?', ['Обычно мастер приезжает в течение 40-60 минут после подтверждения заявки.', 'Точное время зависит от адреса, дорожной ситуации и ближайшего свободного мастера.'])
              +faqItem('initial-3', 'Какие способы оплаты доступны?', ['Можно оплатить наличными или переводом после выполнения работ.', 'Для юридических лиц доступна оплата по счету по предварительной договоренности.'])
              +faqItem('initial-4', 'Какие районы вы обслуживаете?', ['Мы работаем по Москве и Московской области.', 'Если адрес вне зоны обслуживания, калькулятор покажет, что вызов невозможен.'])
              +faqItem('initial-5', 'Даете ли вы гарантию на работы?', ['Да, гарантия распространяется на выполненные работы и использованные материалы.', 'Срок и условия зависят от типа услуги.'])
              +faqItem('initial-6', 'Что делать, если у меня нет запчасти?', ['Сообщите оператору, какая деталь нужна.', 'Мы подскажем, можно ли выполнить работу на месте или потребуется предварительно подготовить материал.'])
              +faqItem('initial-7', 'Работаете ли вы с юридическими лицами?', ['Да, принимаем заявки от компаний, парков и сервисных служб.', 'Можно согласовать регулярное обслуживание и закрывающие документы.'])
              +faqItem('initial-8', 'Можно ли вызвать мастера на другое время?', ['Да, можно выбрать удобное время визита.', 'Оператор подтвердит доступный интервал после оформления заявки.'])
              +faqItem('initial-9', 'Что входит в услугу сезонной замены?', ['Мастер снимет комплект колес, установит другой комплект, проверит давление и затяжку крепежа.', 'Дополнительные услуги можно выбрать в калькуляторе.'])
              +faqItem('initial-10', 'Выезжаете ли за МКАД?', ['Да, выезд за МКАД доступен по Московской области.', 'Стоимость зависит от расстояния от МКАД и текущего дневного или ночного тарифа.'])
              +faqItem('initial-11', 'Что делать, если проблема повторится?', ['Свяжитесь с нами и опишите ситуацию.', 'Если случай гарантийный, мастер повторно проверит работу.'])
              +faqItem('initial-12', 'Можно ли оформить заявку ночью?', ['Да, сервис работает круглосуточно.', 'С 22:00 до 07:00 применяется ночной тариф на выезд.'])
              +faqItem('initial-13', 'Нужно ли заранее готовить место для работы?', ['Желательно оставить доступ к автомобилю и свободное место рядом с ним.', 'Если машина находится в паркинге, заранее уточните высоту въезда и правила доступа.'])
              +faqItem('initial-14', 'Работаете ли вы в подземных паркингах?', ['Да, если есть безопасный доступ к автомобилю и достаточно места для оборудования.', 'При оформлении заявки укажите этаж, сектор и особенности проезда.'])
              +faqItem('initial-15', 'Можно ли отремонтировать боковой порез?', ['Это зависит от размера и расположения повреждения.', 'Мастер осмотрит шину на месте и скажет, возможен ли безопасный ремонт.'])
              +faqItem('initial-16', 'Что такое Run Flat?', ['Run Flat - усиленная шина, на которой можно некоторое время ехать после потери давления.', 'Работа с такими шинами сложнее, поэтому в калькуляторе применяется отдельный коэффициент.'])
              +faqItem('initial-17', 'Можно ли заказать хранение шин?', ['Да, услуга хранения доступна для комплектов разных диаметров.', 'При необходимости можно добавить доставку комплекта.'])
              +faqItem('initial-18', 'Заправляете ли кондиционер на месте?', ['Да, мастер может выполнить заправку кондиционера у дома, офиса или на парковке.', 'Дополнительные опции выбираются в калькуляторе.'])
