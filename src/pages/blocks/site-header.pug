-
  const landingNav = [
    { label: 'О нас', href: '#about' },
    { label: 'Отзывы', href: '#reviews' },
    { label: 'Статьи', href: '#articles' },
    { label: 'Контакты', href: '#contacts' }
  ];
  const landingServices = [
    { category: 'Шиномонтаж', items: ['Правка дисков', 'Снятие секреток', 'Ремонт боковых порезов', 'Ремонт проколов', 'Сезонное хранение шин', 'Шиномонтажные работы', 'Сезонная замена шин'] },
    { category: 'Техпомощь', items: ['Доставка топлива', 'Отогрев автомобиля', 'Запуск двигателя', 'Замена аккумулятора'] }
  ];
  const landingServicesHref = '#services';


div.site-header-shell(data-site-header-root)
  header.landing-hero__header(data-site-header)
    a.landing-hero__brand(href="#top", aria-label="Едем-чиним — на главную")
      svg.landing-hero__brand-car(viewBox="0 0 132 31", fill="none", aria-hidden="true")
        path(d="M5 23c6-5 16-6 28-6 9-8 18-12 35-12 15 0 27 4 39 12 10 0 16 2 20 6M15 23h20m62 0h23M46 13c18-5 33-5 48 2" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round")
      span.landing-hero__brand-name ЕДЕМ–ЧИНИМ
    a.landing-hero__crews(href="./calculator.html", data-open-calculator)
      span.landing-hero__activity(aria-hidden="true")
      span
        strong 14 экипажей
        | #{' '}
        span.landing-hero__crews-note на линии
    nav.landing-hero__nav#landing-hero-menu(aria-label="Разделы сайта", data-landing-menu)
      ul.landing-hero__nav-list
        li.landing-hero__nav-item.landing-hero__nav-item--services.landing-hero__nav-item--catalog(data-menu-item)
          a.landing-hero__nav-button(href=landingServicesHref, aria-expanded="false", aria-controls="landing-services", data-menu-expand)
            span Услуги
            svg.landing-hero__chevron(viewBox="0 0 16 16", fill="none", aria-hidden="true", focusable="false")
              path(d="M3 5.5 8 10.5 13 5.5", stroke="currentColor", stroke-width="1.6", stroke-linecap="round", stroke-linejoin="round")
          ul.landing-hero__submenu.header-services#landing-services
            each group in landingServices
              li.header-services__category
                span.header-services__heading= group.category
                ul.landing-hero__subsubmenu.header-services__list
                  each service in group.items
                    li.header-services__item
                      a.header-services__link(href="./calculator.html", data-open-calculator)
                        svg.header-services__icon(viewBox="0 0 24 24", fill="none", aria-hidden="true")
                          path(d="M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z M12 4v16 M4 12h16 M6.3 6.3l11.4 11.4 M6.3 17.7 17.7 6.3", stroke="currentColor", stroke-width="1.6", stroke-linecap="round", stroke-linejoin="round")
                        span= service
        each item in landingNav
          li.landing-hero__nav-item
            a(href=item.href)= item.label
      div.landing-hero__menu-footer
        p Выездной шиномонтаж в Москве и МО<br>Работаем 24/7
        button.landing-hero__cta.landing-cta(type="button", data-open-calculator)
          span Вызвать мастера
          svg(viewBox="0 0 32 32", fill="none", aria-hidden="true")
            path(d="M5 16h21m-8-8 8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="square")
    div.landing-hero__header-actions
      a.landing-hero__phone(href="tel:+74950000000", aria-label="Позвонить: +7 (495) 000-00-00")
        svg(viewBox="0 0 24 24", fill="currentColor", aria-hidden="true")
          path(d="M6.6 2.5a2 2 0 0 0-2.1.5L2.9 4.6a3 3 0 0 0-.7 3.1c2.2 6.4 7.4 11.6 13.8 13.8a3 3 0 0 0 3.1-.7l1.6-1.6a2 2 0 0 0 .5-2.1l-.9-2.7a2 2 0 0 0-2.1-1.3l-2.8.3a2 2 0 0 0-1.2.6l-1 1a15 15 0 0 1-4.2-4.2l1-1a2 2 0 0 0 .6-1.2l.3-2.8a2 2 0 0 0-1.3-2.1z")
        span +7 (495) 000-00-00
      button.landing-hero__header-cta(type="button", data-open-calculator)
        span Вызвать мастера
      button.landing-hero__menu-toggle(type="button", aria-label="Открыть меню", aria-expanded="false", aria-controls="landing-hero-menu", data-landing-menu-toggle)
        span
        span
        span
