doctype html
- locals.servicePage = require('./data/about-page');
- locals.columnsList = locals.servicePage.columnsList;

html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="theme-color", content="#06141b")
    title= locals.servicePage.meta.title
    meta(name="description", content=locals.servicePage.meta.description)
    meta(property="og:type", content="website")
    meta(property="og:title", content=locals.servicePage.meta.title)
    meta(property="og:description", content=locals.servicePage.meta.description)
    script.
      window.__CALCULATOR_URL__ = './calculator.html';
  body
    div.landing(data-landing)
      include blocks/site-header.pug
      main.landing__main
        include blocks/hero.pug
        include blocks/columns-list.pug
        include blocks/media-rows.pug
        include blocks/split-form.pug
      include blocks/site-footer.pug
      include blocks/mobile-actions.pug
    include blocks/quick-call-dialog.pug
