doctype html
- locals.articlePage = require('./data/article-page');
- locals.servicePage = { form: locals.articlePage.form };
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="theme-color", content="#06141b")
    title= locals.articlePage.title + ' | Едем-чиним'
    meta(name="description", content=locals.articlePage.description)
    meta(property="og:type", content="article")
    meta(property="og:title", content=locals.articlePage.title)
    meta(property="og:description", content=locals.articlePage.description)
    script.
      window.__CALCULATOR_URL__ = './calculator.html?service=seasonal';
  body
    div.landing(data-landing)
      include blocks/site-header.pug
      main.landing__main
        article(aria-labelledby="article-title")
          include blocks/article-hero.pug
          include blocks/article-content.pug
        include blocks/related-service.pug
        include blocks/split-form.pug
      include blocks/site-footer.pug
      include blocks/mobile-actions.pug
    include blocks/quick-call-dialog.pug
