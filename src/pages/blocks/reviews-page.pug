- const items = typeof reviewItems !== 'undefined' ? reviewItems : [];
if items.length
  div.reviews-page__list
    each review, reviewIndex in items
      article.reviews-page__item
        header.reviews-page__meta
          div.reviews-page__identity
            span.reviews-page__name= review.author
            time(datetime=review.dateTime)= review.date
          span.reviews-page__stars(role="img", aria-label="5 из 5") ★★★★★
        div.reviews-page__body
          div
            if review.heading
              h2.reviews-page__heading.landing-subtitle= review.heading
            blockquote.reviews-page__quote= review.text
          if review.photos && review.photos.length
            div.reviews-page__photos
              each photo in review.photos
                a(href=photo, data-collection-photo, data-gallery=`review-${reviewIndex}`, aria-label="Открыть фотографию отзыва")
                  img(src=photo, alt="Фото из отзыва клиента", width="80", height="80", loading="lazy")
        footer.reviews-page__author
          button.reviews-page__more(type="button", data-review-open, aria-haspopup="dialog", hidden) Читать полностью
          if review.service
            div.reviews-page__service
              span.reviews-page__service-label Услуга:
              span= review.service
  include review-dialog.pug
else
  p.support-page__empty.landing-text Отзывы пока не добавлены.
