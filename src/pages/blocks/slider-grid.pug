- const reviews = require('../data/reviews.js');

section.slider-grid.landing-section#reviews(aria-labelledby="slider-grid-title", data-review-catalog)
  header.slider-grid__header
    p.slider-grid__eyebrow.landing-eyebrow ОТЗЫВЫ КЛИЕНТОВ
    h2.slider-grid__title.landing-title.landing-title--section#slider-grid-title Что говорят клиенты
    p.slider-grid__lead.landing-text Срочные выезды, сезонная замена колёс и помощь на дороге.
    div.slider-grid__rating
      span.slider-grid__stars(aria-hidden="true") ★★★★★
      strong 5,0 из 5
      span Отзывы клиентов
  div.slider-grid__filters.cards-grid__filters(role="group", aria-label="Отзывы по услугам")
    each label in ['Все', ...new Set(reviews.map(review => review.service))]
      button.cards-grid__filter(type="button", data-review-filter=label === 'Все' ? 'all' : label, aria-pressed=label === 'Все' ? 'true' : 'false', aria-controls="reviews-track")= label
  p.visually-hidden(data-review-filter-status, role="status", aria-live="polite")
  div.slider-grid__track#reviews-track(data-review-slider, tabindex="0", aria-label="Отзывы клиентов")
    each review in reviews
      article.slider-grid__item(data-review-card, data-review-service=review.service)
        span.slider-grid__stars(role="img", aria-label="5 из 5 звёзд") ★★★★★
        div.slider-grid__body
          div.slider-grid__text
            if review.heading
              h3.slider-grid__review-heading= review.heading
            blockquote.slider-grid__quote= review.text
            button.slider-grid__more(type="button", data-review-open, hidden) Читать полностью
          if review.photos && review.photos.length
            div.slider-grid__photos(data-review-photos)
              each photo in review.photos
                a(href=photo, data-review-photo, data-gallery=`review-${review.dateTime}`, aria-label="Открыть фото из отзыва")
                  img(src=photo, alt="Иллюстрация работ для макета отзыва", loading="lazy")
        p.slider-grid__service
          svg.slider-grid__service-icon(viewBox="0 0 24 24", fill="none", aria-hidden="true")
            path(d="M20 12a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z M12 4v16 M4 12h16 M6.3 6.3l11.4 11.4 M6.3 17.7 17.7 6.3", stroke="currentColor", stroke-width="1.6", stroke-linecap="round", stroke-linejoin="round")
          span= review.service
        div.slider-grid__author
          if review.photo
            img.slider-grid__avatar(src=review.photo, alt="", loading="lazy", decoding="async")
          else
            span.slider-grid__avatar.slider-grid__avatar--initials(aria-hidden="true")= review.initials
          div.slider-grid__author-meta
            cite.slider-grid__author-name= review.author
            time.slider-grid__date(datetime=review.dateTime)= review.date
  div.slider-grid__controls(role="group", aria-label="Управление отзывами")
    button.landing-slider-arrow.slider-grid__arrow(type="button", data-review-prev, aria-label="Предыдущий отзыв")
      svg(viewBox="0 0 32 32", fill="none", aria-hidden="true")
        path(d="M26 16H6m8-8-8 8 8 8", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
    span.slider-grid__counter(aria-live="polite")
      span(data-review-current) 01
      span.slider-grid__counter-total  / #[span(data-review-total)= reviews.length.toString().padStart(2, '0')]
    button.landing-slider-arrow.landing-slider-arrow--next.slider-grid__arrow(type="button", data-review-next, aria-label="Следующий отзыв")
      svg(viewBox="0 0 32 32", fill="none", aria-hidden="true")
        path(d="M6 16h20m-8-8 8 8-8 8", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
  dialog.slider-grid__dialog(data-review-dialog, aria-labelledby="slider-grid-dialog-title")
    div.slider-grid__dialog-inner
      button.slider-grid__dialog-close(type="button", data-review-close, aria-label="Закрыть отзыв") ×
      h3.slider-grid__dialog-title#slider-grid-dialog-title Отзыв клиента
      span.slider-grid__stars(data-review-dialog-stars, role="img")
      blockquote.slider-grid__dialog-quote(data-review-dialog-text)
      div.slider-grid__dialog-photos(data-review-dialog-photos)
      p.slider-grid__dialog-service(data-review-dialog-service)
      div.slider-grid__dialog-author
        cite(data-review-dialog-author)
        time(data-review-dialog-date)
  footer.slider-grid__footer
    a.slider-grid__all.landing-more-link(href="/otzyvy/") Больше отзывов
      svg(viewBox="0 0 32 32", fill="none", aria-hidden="true")
        path(d="M5 16h22m-8-8 8 8-8 8", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
