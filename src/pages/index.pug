doctype html
-
  const seasonIcon = require('../img/season.svg');
  const prokolIcon = require('../img/prokol.svg');
  const condIcon = require('../img/cond.svg');
  const storageIcon = require('../img/storage.svg');
  const lightIcon = require('../img/light.svg');
  const crossIcon = require('../img/cross.svg');
  const offroadIcon = require('../img/offroad.svg');
  const furaIcon = require('../img/fura.svg');

html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="theme-color", content="#080c12")
    title Выездной шиномонтаж 24/7
    script.
      window.__YANDEX_MAPS_URL__ = !{JSON.stringify(yandexMapsUrl || '')};
      window.__YANDEX_MAPS_DISABLED__ = !{JSON.stringify(!yandexMapsUrl)};
      window.__YANDEX_SUGGEST_DISABLED__ = !{JSON.stringify(Boolean(yandexMapsUrl && !hasYandexSuggestApiKey))};
  body
    main.landing(data-landing)
      include blocks/hero.pug
      include blocks/features-grid.pug
      include blocks/steps-grid.pug
      include blocks/cards-grid.pug
      include blocks/media-rows.pug
      include blocks/slider-grid.pug
      include blocks/map-panel.pug
    include blocks/quick-call-dialog.pug
    div.app#app(data-app, hidden)
      button.app__back(type="button", data-close-calculator, aria-label="Вернуться на главную") ← На главную
      main.app__screens
        section.order-screen(aria-label="Заказ шиномонтажа")
          header.hero
            div.hero__map-placeholder(data-service-map, role="img", aria-label="Место для карты")
            div.map-overlay
              div.map-overlay__zoom(aria-label="Масштаб карты")
                button.map-overlay__control(type="button", aria-label="Приблизить карту", data-service-map-zoom="in")
                  svg.icon-circle.icon-circle--small(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                      path(fill="currentColor" d="M5 13v-1h6V6h1v6h6v1h-6v6h-1v-6z")
                button.map-overlay__control(type="button", aria-label="Отдалить карту", data-service-map-zoom="out")
                  svg.icon-circle.icon-circle--small(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                    path(fill="currentColor" d="M5 13v-1h13v1z")
              button.map-overlay__location(type="button", aria-label="Использовать текущее местоположение", data-location-button)
                  svg.icon-circle.icon-circle--small(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                      path(fill="currentColor" d="M11.5 21.45v-1.461q-3.125-.293-5.16-2.328q-2.036-2.036-2.328-5.161H2.55v-1h1.462q.292-3.125 2.328-5.16t5.16-2.328V2.55h1v1.462q3.125.292 5.16 2.328t2.329 5.16h1.461v1h-1.461q-.293 3.125-2.328 5.16q-2.036 2.036-5.161 2.329v1.461zm5.45-4.5Q19 14.9 19 12t-2.05-4.95T12 5T7.05 7.05T5 12t2.05 4.95T12 19t4.95-2.05m-7.073-2.827Q9 13.246 9 12t.877-2.123T12 9t2.123.877T15 12t-.877 2.123T12 15t-2.123-.877m3.536-.71Q14 12.825 14 12t-.587-1.412T12 10t-1.412.588T10 12t.588 1.413T12 14t1.413-.587M12 12")
          section.calculator(data-calculator)
            button.calculator__handle(type="button", aria-label="Развернуть калькулятор", aria-expanded="false", data-calculator-toggle)
              span(aria-hidden="true")
            h2.visually-hidden Калькулятор заказа
            form.calculator__form(action="#", data-calculator-form, autocomplete="off")

              fieldset.calculator__section
                div.address-row
                  label.address-field(for="address-input")
                    svg.icon-circle.icon-circle--small(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                      path(fill="currentColor" d="M13.143 11.259q.473-.472.473-1.143q0-.672-.473-1.144Q12.671 8.5 12 8.5t-1.143.472t-.472 1.144q0 .67.472 1.143q.472.472 1.143.472t1.143-.472M12 19.677q2.82-2.454 4.458-4.991t1.638-4.39q0-2.744-1.737-4.53Q14.62 3.981 12 3.981T7.641 5.766t-1.737 4.53q0 1.852 1.638 4.39T12 19.677m0 1.342q-3.525-3.117-5.31-5.814q-1.786-2.697-1.786-4.909q0-3.173 2.066-5.234Q9.037 3 12 3t5.03 2.062q2.066 2.061 2.066 5.234q0 2.212-1.785 4.909q-1.786 2.697-5.311 5.814m0-10.903")
                    input#address-input.address-field__input(type="text", name="address", placeholder="Введите адрес", autocomplete="street-address", data-address-input)
                p.address-status(data-location-status, aria-live="polite")

              fieldset.calculator__section.calculator__section--details
                legend.calculator__legend Услуга
                div.option-grid.option-grid--services(data-option-group="service")
                  button.option-card.option-card--active(type="button", data-option-name="service", data-option-value="seasonal", aria-pressed="true")
                    img(src=seasonIcon, alt="", loading="lazy", decoding="async")
                    span.option-card__label Сезонная замена
                  button.option-card(type="button", data-option-name="service", data-option-value="puncture", aria-pressed="false")
                    img(src=prokolIcon, alt="", loading="lazy", decoding="async")
                    span.option-card__label Ремонт прокола
                  button.option-card(type="button", data-option-name="service", data-option-value="conditioner", aria-pressed="false")
                    img(src=condIcon, alt="", loading="lazy", decoding="async")
                    span.option-card__label Заправка кондиционера
                  button.option-card(type="button", data-option-name="service", data-option-value="storage", aria-pressed="false")
                    img(src=storageIcon, alt="", loading="lazy", decoding="async")
                    span.option-card__label Хранение шин

              fieldset.calculator__section.calculator__section--details(data-service-section="vehicle")
                legend.calculator__legend Тип автомобиля
                div.option-grid.option-grid--cars(data-option-group="carType")
                  button.option-card.option-card--active(type="button", data-option-name="carType", data-option-value="passenger", aria-pressed="true")
                    img(src=lightIcon, alt="", loading="lazy", decoding="async")
                    span.option-card__label Легковой
                  button.option-card(type="button", data-option-name="carType", data-option-value="crossover", aria-pressed="false")
                    img(src=crossIcon, alt="", loading="lazy", decoding="async")
                    span.option-card__label Кроссовер
                  button.option-card(type="button", data-option-name="carType", data-option-value="suv", aria-pressed="false")
                    img(src=offroadIcon, alt="", loading="lazy", decoding="async")
                    span.option-card__label Внедорожник
                  button.option-card(type="button", data-option-name="carType", data-option-value="commercial", data-service-only="conditioner", aria-pressed="false", hidden)
                    img(src=furaIcon, alt="", loading="lazy", decoding="async")
                    span.option-card__label Спецтехника, грузовое авто

              fieldset.calculator__section.calculator__section--details(data-service-section="diameter")
                legend.calculator__legend Диаметр колес
                div.diameter-slider(data-diameter-slider)
                  div.diameter-slider__header
                    output#diameter-output.diameter-slider__value(for="diameter-range", data-diameter-output) R12
                  input(type="hidden", name="diameter", value="r12", data-diameter-value)
                  input#diameter-range.diameter-slider__control(type="range", min="0", max="12", step="1", value="0", aria-labelledby="diameter-output", data-diameter-range)
                  div.diameter-slider__marks(aria-hidden="true")
                    span R12
                    span R24

              fieldset.calculator__section.calculator__section--details(data-service-section="seasonal-addons")
                legend.calculator__legend Дополнительные услуги
                div.checkbox-grid
                  label.checkbox-card
                    input.checkbox-card__control(type="checkbox", name="copperGrease", data-addon-name="copperGrease")
                    span.checkbox-card__label Медная смазка
                    span.checkbox-card__price +700 ₽
                  label.checkbox-card
                    input.checkbox-card__control(type="checkbox", name="hubCleaning", data-addon-name="hubCleaning")
                    span.checkbox-card__label Механическая чистка ступиц
                    span.checkbox-card__price +800 ₽

              fieldset.calculator__section.calculator__section--details(data-service-section="vehicle-addons")
                legend.calculator__legend Особенности шин
                div.checkbox-grid
                  label.checkbox-card
                    input.checkbox-card__control(type="checkbox", name="lowProfile", data-addon-name="lowProfile")
                    span.checkbox-card__label Низкий профиль
                    span.checkbox-card__price +20%
                  label.checkbox-card
                    input.checkbox-card__control(type="checkbox", name="reinforcedTire", data-addon-name="reinforcedTire")
                    span.checkbox-card__label Run Flat / C / AT
                    span.checkbox-card__price +40%

              fieldset.calculator__section.calculator__section--details(data-service-section="conditioner-addons" hidden)
                legend.calculator__legend Дополнительно
                div.checkbox-grid
                  label.checkbox-card
                    input.checkbox-card__control(type="checkbox", name="freon134", data-addon-name="freon134")
                    span.checkbox-card__label Дополнительно фреон 134А 100 г
                    span.checkbox-card__price +500 ₽
                  label.checkbox-card
                    input.checkbox-card__control(type="checkbox", name="antibacterial", data-addon-name="antibacterial")
                    span.checkbox-card__label Антибактериальная обработка системы
                    span.checkbox-card__price +500 ₽
                  label.checkbox-card
                    input.checkbox-card__control(type="checkbox", name="extraCircuit", data-addon-name="extraCircuit")
                    span.checkbox-card__label Дополнительный контур
                    span.checkbox-card__price +70%

              fieldset.calculator__section.calculator__section--details(data-service-section="storage-addons" hidden)
                legend.calculator__legend Дополнительно
                div.checkbox-grid
                  label.checkbox-card
                    input.checkbox-card__control(type="checkbox", name="storageDelivery", data-addon-name="storageDelivery")
                    span.checkbox-card__label Доставка
                    span.checkbox-card__price +3 500 ₽

              div.calculator__footer.calculator__section--details
                div.order-summary(aria-live="polite")
                  div.order-summary__item
                    span.order-summary__label Стоимость
                    span.order-summary__line
                      span(data-price-prefix) от
                      output.order-summary__value(data-price-output, for="diameter-range") 2 700
                      span(data-price-unit) ₽
                  div.order-summary__item
                    span.order-summary__label Время прибытия
                    span.order-summary__line
                      output.order-summary__value(data-time-output) —
                      span(data-time-unit) мин

                button.primary-button(type="submit", data-order-submit) Продолжить

            form.order-confirm(action="#", data-order-form, hidden)
              h2.order-confirm__title Подтверждение заявки
              dl.order-details(data-order-details)
              input(type="hidden", name="order_service", data-order-field="service_label")
              input(type="hidden", name="order_service_key", data-order-field="service")
              input(type="hidden", name="order_address", data-order-field="address")
              input(type="hidden", name="order_car_type", data-order-field="car_type_label")
              input(type="hidden", name="order_car_type_key", data-order-field="car_type")
              input(type="hidden", name="order_diameter", data-order-field="diameter_label")
              input(type="hidden", name="order_diameter_key", data-order-field="diameter")
              input(type="hidden", name="order_addons", data-order-field="addons")
              input(type="hidden", name="order_addon_keys", data-order-field="addon_keys")
              input(type="hidden", name="order_price", data-order-field="price_text")
              input(type="hidden", name="order_price_value", data-order-field="price")
              input(type="hidden", name="order_callout_price_value", data-order-field="callout_price")
              input(type="hidden", name="order_service_price_value", data-order-field="service_price")
              input(type="hidden", name="order_arrival_time", data-order-field="arrival_time")
              input(type="hidden", name="order_tariff", data-order-field="tariff")
              input(type="hidden", name="order_is_night_tariff", data-order-field="is_night_tariff")
              input(type="hidden", name="order_location_status", data-order-field="location_status")
              input(type="hidden", name="order_inside_mkad", data-order-field="inside_mkad")
              input(type="hidden", name="order_distance_outside_mkad_km", data-order-field="distance_outside_mkad_km")
              input(type="hidden", name="order_coords", data-order-field="coords")
              input(type="hidden", name="order_phone", data-order-field="phone")
              input(type="hidden", name="order_details", data-order-field="details")
              input(type="hidden", name="order_payload", data-order-field="payload")
              label.phone-field(for="order-phone")
                span.phone-field__label Телефон для связи
                input#order-phone.phone-field__input(type="tel", name="phone", inputmode="tel", autocomplete="tel", placeholder="+7 (___) ___-__-__")
              div.order-confirm__footer
                button.secondary-button(type="button", data-order-back) Назад
                button.primary-button(type="submit", data-order-send, disabled) Отправить

            div.order-success(data-order-success, hidden)
              span.order-success__icon(aria-hidden="true")
              h2.order-success__title Заявка принята
              p.order-success__text Мы получили данные и скоро свяжемся для подтверждения времени выезда.
              div.order-success__summary(data-success-summary)
              button.primary-button(type="button", data-order-success-back) Вернуться к заказу

          div.map-picker(data-map-picker, hidden)
            div.map-picker__panel(role="dialog", aria-modal="true", aria-labelledby="map-picker-title")
              div.map-picker__header
                h2#map-picker-title.map-picker__title Выберите точку на карте
                button.map-picker__close(type="button", aria-label="Закрыть карту", data-map-picker-close)
                  span(aria-hidden="true") ×
              div.map-picker__map
                div.map-picker__canvas(data-map-picker-canvas)
                div.map-picker__zoom-controls(aria-label="Масштаб карты")
                  button.map-picker__zoom-button(type="button", aria-label="Приблизить карту", data-map-picker-zoom="in") +
                  button.map-picker__zoom-button(type="button", aria-label="Отдалить карту", data-map-picker-zoom="out") -
              p.map-picker__status(data-map-picker-status, aria-live="polite") Нажмите на карту, чтобы выбрать адрес
              div.map-picker__footer
                button.secondary-button(type="button", data-map-picker-cancel) Отмена
                button.primary-button(type="button", data-map-picker-apply, disabled) Выбрать адрес

          aside.trust-panel(aria-label="Показатели сервиса")
            div.trust-panel__item
              svg.icon-circle.icon-circle--medium(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                path(fill="currentColor" d="m8.125 7.092l2.608-3.47q.242-.324.568-.473T12 3t.699.149t.568.472l2.608 3.471l4.02 1.368q.534.18.822.602t.289.938q0 .242-.069.475t-.23.45l-2.634 3.573l.1 3.83q.025.703-.47 1.188q-.493.484-1.14.484l-.453-.056L12 18.733l-4.11 1.211q-.124.05-.236.053T7.437 20q-.666 0-1.15-.484q-.485-.485-.46-1.187l.1-3.856l-2.629-3.548q-.161-.217-.23-.45T3 10q0-.51.295-.941t.83-.618zm.629.86L4.462 9.398q-.289.096-.395.394t.087.548l2.792 3.84l-.119 4.16q-.02.327.23.52q.25.192.559.096L12 17.696l4.385 1.285q.307.096.557-.096q.25-.193.231-.52l-.12-4.184l2.793-3.79q.192-.25.087-.549q-.106-.298-.395-.394l-4.292-1.496l-2.765-3.683q-.173-.25-.481-.25t-.48.25zM12 11.519")
              strong 4.9
              span.trust-panel__text рейтинг
            div.trust-panel__item
              svg.icon-circle.icon-circle--medium(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                path(fill="currentColor" d="M12 20.962q-3.014-.895-5.007-3.651T5 11.1V5.692l7-2.615l7 2.615V11.1q0 3.454-1.993 6.21T12 20.963m0-1.062q2.6-.825 4.3-3.3t1.7-5.5V6.375l-6-2.23l-6 2.23V11.1q0 3.025 1.7 5.5t4.3 3.3m0-7.88")
              strong 3500+
              span.trust-panel__text успешных выездов
            div.trust-panel__item
              svg.icon-circle.icon-circle--medium(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24")
                path(fill="currentColor" d="M14.935 16.223L11.5 12.789V7.923h1v4.464l3.123 3.123zM11.5 6V4h1v2zm6.5 6.5v-1h2v1zM11.5 20v-2h1v2zM4 12.5v-1h2v1zm8.003 8.5q-1.867 0-3.51-.708q-1.643-.709-2.859-1.924t-1.925-2.856T3 12.003t.709-3.51Q4.417 6.85 5.63 5.634t2.857-1.925T11.997 3t3.51.709q1.643.708 2.859 1.922t1.925 2.857t.709 3.509t-.708 3.51t-1.924 2.859t-2.856 1.925t-3.509.709M12 20q3.35 0 5.675-2.325T20 12t-2.325-5.675T12 4T6.325 6.325T4 12t2.325 5.675T12 20m0-8")
              strong 24/7
              span.trust-panel__text работаем круглосуточно
