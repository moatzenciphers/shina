doctype html
-
  const authorImage = require('../img/author.jpg');
  const reviewImage = require('../img/remont.jpg');
  const seasonIcon = require('../img/season.svg');
  const prokolIcon = require('../img/prokol.svg');
  const condIcon = require('../img/cond.svg');
  const storageIcon = require('../img/storage.svg');
  const lightIcon = require('../img/light.svg');
  const crossIcon = require('../img/cross.svg');
  const offroadIcon = require('../img/offroad.svg');
  const furaIcon = require('../img/fura.svg');
  const photoServiceLabels = {
    seasonal: 'Сезонная замена',
    puncture: 'Ремонт прокола',
    storage: 'Хранение шин',
    conditioner: 'Заправка кондиционера'
  };

mixin reviewStars(rating)
  -
    const filledStars = Math.max(0, Math.min(5, Math.round(Number(rating) || 0)));
  span.review-rating__stars(aria-hidden="true")
    each starIndex in [1, 2, 3, 4, 5]
      if starIndex <= filledStars
        span.review-rating__star
      else
        span.review-rating__star.review-rating__no-fill

mixin reviewCard(id, type, author, date, rating, text)
  article.review-card(data-review-type=type)
    header.review-card__header
      img.review-card__avatar(src=authorImage, alt="", loading="lazy", decoding="async")
      div.review-card__meta
        h3.review-card__author= author
        div.review-rating(aria-label=`Оценка ${rating} из 5`)
          +reviewStars(rating)
          span.review-rating__value= rating
      span.review-card__date= date
    p.review-card__text= text
    div.review-card__gallery
      a.review-card__photo-link.glightbox(href=reviewImage, data-gallery='review-' + id, data-type="image")
        img.review-card__photo(src=reviewImage, alt="", loading="lazy", decoding="async")

mixin photoCard(id, type, label, modifier = '')
  article.photo-card(class=modifier, data-photo-type=type)
    a.photo-card__link.glightbox(href=reviewImage, aria-label=label, data-gallery="service-photos", data-type="image", data-description=label, data-desc-position="bottom")
      img.photo-card__image(src=reviewImage, alt=label, loading="lazy", decoding="async")

mixin faqItem(id, question, answer, isOpen = false)
  details.faq-item(data-faq-item, open=isOpen)
    summary.faq-item__question
      span= question
      span.faq-item__marker(aria-hidden="true")
    div.faq-item__answer
      each paragraph in answer
        p= paragraph

