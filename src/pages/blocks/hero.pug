-
  const reviews = require('../data/reviews.js');

section.landing-hero(aria-labelledby="landing-hero-title")
  picture.landing-hero__picture(aria-hidden="true")
    img(src=require('../../img/desktop-hero.jpg'), alt="")
  div.landing-hero__inner
    div.landing-hero__content#top
      a.landing-hero__rating(href="#reviews", aria-label="Наш рейтинг 4,9 из 5. Отзывы клиентов")
        span.landing-hero__rating-label НАШ РЕЙТИНГ
        span.landing-hero__rating-row
          span.landing-hero__stars(aria-hidden="true")
            each index in [0, 1, 2, 3, 4]
              svg(viewBox="0 0 24 24")
                path.landing-hero__star-base(d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2-6.2 3.2 1.2-6.8-5-4.9 6.9-1Z")
                path.landing-hero__star-fill(d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2-6.2 3.2 1.2-6.8-5-4.9 6.9-1Z", style=index === 4 ? 'clip-path: inset(0 10% 0 0)' : '')
          span.landing-hero__rating-value #[strong 4,9] из 5
          span.landing-hero__rating-count Отзывы клиентов
      h1.landing-hero__title#landing-hero-title
        span.landing-hero__title-first ВЫЕЗДНОЙ
        span.landing-hero__title-second ШИНОМОНТАЖ
        span.landing-hero__hours(aria-label="24/7")
          span(aria-hidden="true") 24/7
      p.landing-hero__lead Приедем и починим на месте.
      ul.landing-hero__benefits
        each benefit in [{title: 'Быстрый выезд', text: 'от 15 минут', icon: 'M12 8v5l3 2 M9 2h6 M12 2v3 M18 6l2-2 M21 14a9 9 0 1 1-18 0 9 9 0 0 1 18 0'}, {title: 'Прозрачная стоимость', text: 'до начала работ', icon: 'M6 3h9l4 4v14l-3-2-4 2-4-2-3 2V3Z M14 3v5h5 M8 11h7 M8 15h7'}, {title: 'Гарантия', text: 'на работы и материалы', icon: 'M12 2 3 6v6c0 5 4 8 9 10 5-2 9-5 9-10V6l-9-4Z M8 12l3 3 5-6'}]
          li
            svg(viewBox="0 0 24 24", fill="none", aria-hidden="true")
              path(d=benefit.icon, stroke="currentColor", stroke-width="1.6", stroke-linecap="round", stroke-linejoin="round")
            div
              strong= benefit.title
              span= benefit.text
      div.landing-hero__visual-space(aria-hidden="true")
      a.landing-hero__cta.landing-cta(href="./calculator.html", data-open-calculator)
        span Рассчитать стоимость
        svg(viewBox="0 0 32 32", fill="none", aria-hidden="true")
          path(d="M5 16h22m-8-8 8 8-8 8", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
      div.landing-hero__prices(aria-label="Стоимость выезда")
        div.landing-hero__price
          span Выезд в пределах МКАД —
          strong от 1 500 ₽
        div.landing-hero__price
          span Выезд за МКАД —
          strong от 2 000 ₽ + 40 ₽/км
