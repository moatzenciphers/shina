div.contacts-page__map(data-coverage-map)
  div.map-panel__canvas(data-coverage-canvas, role="application", aria-label="Карта зоны выезда: Москва и Московская область")
  p.contacts-page__map-status(role="status", aria-live="polite", data-coverage-status) Загружаем карту…
  div.map-overlay
    div.map-overlay__zoom(aria-label="Масштаб карты")
      button.map-overlay__control(type="button", data-coverage-zoom="in", aria-label="Приблизить карту", disabled)
        svg(viewBox="0 0 24 24", width="24", height="24", fill="none", aria-hidden="true")
          path(d="M5 12h14M12 5v14", stroke="currentColor", stroke-width="2")
      button.map-overlay__control(type="button", data-coverage-zoom="out", aria-label="Отдалить карту", disabled)
        svg(viewBox="0 0 24 24", width="24", height="24", fill="none", aria-hidden="true")
          path(d="M5 12h14", stroke="currentColor", stroke-width="2")
    button.map-overlay__location(type="button", data-coverage-location, aria-label="Моё местоположение", disabled)
      svg(viewBox="0 0 24 24", width="24", height="24", fill="none", aria-hidden="true")
        circle(cx="12", cy="12", r="7", stroke="currentColor", stroke-width="1.6")
        path(d="M12 2v3M12 19v3M2 12h3M19 12h3", stroke="currentColor", stroke-width="1.6")
