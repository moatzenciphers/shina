-
  const landingNav = [
    { label: 'О нас', href: '#about' },
    { label: 'Отзывы', href: '#reviews' },
    { label: 'Статьи', href: '#articles' },
    { label: 'Контакты', href: '#contacts' }
  ];
  const landingServices = [
    { label: 'Сезонная замена', href: '#service-seasonal', allLabel: 'Все о сезонной замене', children: ['Легковой автомобиль', 'Кроссовер', 'Внедорожник'] },
    { label: 'Ремонт прокола', href: '#service-puncture', allLabel: 'Все о ремонте прокола', children: ['Низкий профиль', 'Run Flat / C / AT'] },
    { label: 'Хранение шин', href: '#service-storage', allLabel: 'Все о хранении шин', children: ['Доставка'] },
    { label: 'Заправка кондиционера', href: '#service-conditioner', allLabel: 'Все о заправке кондиционера', children: ['Фреон 134А', 'Антибактериальная обработка', 'Дополнительный контур'] }
  ];
  const landingServicesHref = '#services';

section.landing-hero(aria-labelledby="landing-hero-title")
  picture.landing-hero__picture(aria-hidden="true")
    img(src=require('../../img/back.png'), alt="")
  header.landing-hero__header
    a.landing-hero__brand(href="#top", aria-label="Едем-чиним — на главную")
      svg.landing-hero__brand-car(viewBox="0 0 132 31", fill="none", aria-hidden="true")
        path(d="M5 23c6-5 16-6 28-6 9-8 18-12 35-12 15 0 27 4 39 12 10 0 16 2 20 6M15 23h20m62 0h23M46 13c18-5 33-5 48 2" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round")
      span.landing-hero__brand-name ЕДЕМ–ЧИНИМ
    nav.landing-hero__nav#landing-hero-menu(aria-label="Разделы сайта", data-landing-menu)
      ul.landing-hero__nav-list
        li.landing-hero__nav-item.landing-hero__nav-item--services(data-menu-item)
          a.landing-hero__nav-button(href=landingServicesHref, aria-expanded="false", aria-controls="landing-services", data-menu-expand)
            span Услуги
            span.landing-hero__chevron(aria-hidden="true")
          ul.landing-hero__submenu#landing-services
            if landingServicesHref
              li.landing-hero__all-link
                a(href=landingServicesHref) Рассчитать стоимость
            each service, index in landingServices
              li.landing-hero__submenu-item(data-menu-item)
                a.landing-hero__submenu-button(href=service.href, aria-expanded="false", aria-controls=`landing-service-${index}`, data-menu-expand)
                  span= service.label
                  span.landing-hero__chevron(aria-hidden="true")
                ul.landing-hero__subsubmenu(id=`landing-service-${index}`)
                  if service.href
                    li.landing-hero__all-link
                      a(href=service.href)= service.allLabel
                  each child in service.children
                    li
                      a(href="#calculator", data-open-calculator)= child
        each item in landingNav
          li.landing-hero__nav-item
            a(href=item.href)= item.label
      div.landing-hero__menu-footer
        p Выездной шиномонтаж в Москве и МО<br>Работаем 24/7
        button.landing-hero__cta.landing-cta(type="button", data-open-calculator)
          span Вызвать мастера
          svg(viewBox="0 0 32 32", fill="none", aria-hidden="true")
            path(d="M5 16h21m-8-8 8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="square")
    div.landing-hero__header-actions
      a.landing-hero__phone(href="tel:+74950000000", aria-label="Позвонить: +7 (495) 000-00-00")
        svg(viewBox="0 0 24 24", fill="currentColor", aria-hidden="true")
          path(d="M6.6 2.5a2 2 0 0 0-2.1.5L2.9 4.6a3 3 0 0 0-.7 3.1c2.2 6.4 7.4 11.6 13.8 13.8a3 3 0 0 0 3.1-.7l1.6-1.6a2 2 0 0 0 .5-2.1l-.9-2.7a2 2 0 0 0-2.1-1.3l-2.8.3a2 2 0 0 0-1.2.6l-1 1a15 15 0 0 1-4.2-4.2l1-1a2 2 0 0 0 .6-1.2l.3-2.8a2 2 0 0 0-1.3-2.1z")
        span +7 (495) 000-00-00
      button.landing-hero__header-cta(type="button", data-open-calculator)
        span Вызвать мастера
      button.landing-hero__menu-toggle(type="button", aria-label="Открыть меню", aria-expanded="false", aria-controls="landing-hero-menu", data-landing-menu-toggle)
        span
        span
        span
  div.landing-hero__content#top
    p.landing-hero__outline(aria-hidden="true")
      span ЕДЕМ–
      span ЧИНИМ
    h1.landing-hero__title.landing-title.landing-title--hero#landing-hero-title ВЫЕЗДНОЙ<br>ШИНОМОНТАЖ 24/7
    p.landing-hero__lead.landing-text.landing-text--hero Быстро приедем в любую точку Москвы и МО.<br class="landing-hero__desktop-break"> Поможем продолжить движение.
    button.landing-hero__cta.landing-cta(type="button", data-open-calculator)
      span Вызвать мастера
      svg(viewBox="0 0 32 32", fill="none", aria-hidden="true")
        path(d="M5 16h21m-8-8 8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="square")
    div.landing-hero__prices(aria-label="Стоимость выезда")
      div.landing-hero__price
        span Выезд в пределах МКАД —
        strong от 1 500 ₽
      div.landing-hero__price
        span Выезд за МКАД —
        strong от 2 000 ₽ + 40 ₽/км
      p.landing-hero__minimum Минимальный заказ — #[strong от 2 500 ₽]
