-
  const questions = [
    [
      { question: 'Как быстро приедет мастер?', answer: 'При срочном заказе ориентировочное время подачи — 15–30 минут. Оно зависит от пробок, погоды, адреса и загрузки мастеров. Точное время сообщит оператор после подтверждения заявки.' },
      { question: 'Как формируется стоимость?', answer: 'Стоимость зависит от выбранной услуги, автомобиля, объёма работ и адреса выезда. Предварительную сумму покажет калькулятор, а окончательную мастер согласует с вами до начала работы.' },
      { question: 'Может ли цена измениться после приезда мастера?', answer: 'Если на месте понадобятся дополнительные работы, мастер объяснит их стоимость и согласует её с вами до выполнения.' },
      { question: 'Нужно ли заранее снимать колёса?', answer: 'Нет. Мастер привезёт необходимый инструмент и выполнит работу с колёсами на месте.' },
      { question: 'Вы работаете ночью и в праздники?', answer: 'Да, выезд доступен круглосуточно, включая выходные и праздничные дни.' }
    ],
    [
      { question: 'Можно заказать шиномонтаж на определённое время?', answer: 'Да. Несрочный выезд можно запланировать на удобные дату и время при оформлении заявки.' },
      { question: 'Что делать, если я не знаю точную причину поломки?', answer: 'Опишите оператору, что произошло и какие признаки неисправности вы заметили. Это поможет подобрать мастера и оборудование для выезда.' },
      { question: 'Какие способы оплаты доступны?', answer: 'Уточните доступные способы оплаты у оператора при подтверждении заявки. Оплата производится после выполнения работы.' },
      { question: 'Вы даёте гарантию?', answer: 'Условия гарантии зависят от услуги и фиксируются при оформлении заказа.' },
      { question: 'Можно ли вызвать мастера за МКАД?', answer: 'Да, выезжаем по Московской области. Стоимость выезда за МКАД зависит от расстояния и показывается после проверки адреса.' }
    ]
  ];

section.accordion-grid.landing-section#faq(aria-labelledby="accordion-grid-title")
  header.accordion-grid__header
    p.accordion-grid__eyebrow.landing-eyebrow ЧАСТЫЕ ВОПРОСЫ
    h2.accordion-grid__title.landing-title.landing-title--section#accordion-grid-title Ответы на вопросы о выездном шиномонтаже
  div.accordion-grid__columns
    each column, columnIndex in questions
      div.accordion-grid__column
        each item, itemIndex in column
          details.accordion-grid__item(open=(columnIndex === 0 && itemIndex === 0))
            summary.accordion-grid__question= item.question
            p.accordion-grid__answer.landing-text= item.answer
